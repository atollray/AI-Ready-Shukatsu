{
  "name": "ai-ready-shukatsu",
  "version": "0.2.0",
  "description": "AI-Ready Shukatsu Assistant",
  "private": true,
  "type": "module",
  "bin": {
    "shukatsu": "./dist/cli.js"
  },
  "scripts": {
    "dev": "concurrently -n srv,web -c blue,green \"tsx watch src/server/node.ts\" \"vite\"",
    "build": "pnpm build:node && pnpm build:web",
    "build:node": "tsup",
    "build:web": "vite build",
    "test": "pnpm build:node && vitest run",
    "test:e2e": "playwright test",
    "lint": "biome check src tests",
    "lint:fix": "biome check --write src tests",
    "format": "biome format --write src tests",
    "sk": "node dist/cli.js",
    "sk:dev": "tsx src/cli/index.ts",
    "agents:sync": "tsx scripts/sync-skills.ts",
    "prepare": "pnpm build:node"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@hono/zod-validator": "^0.4.3",
    "@tanstack/react-query": "^5.66.0",
    "chokidar": "^4.0.3",
    "citty": "^0.1.6",
    "hono": "^4.7.1",
    "lucide-react": "^1.72.0",
    "open": "^10.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@playwright/test": "^1.64.1",
    "@types/node": "^20.17.19",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsup": "^8.3.6",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
